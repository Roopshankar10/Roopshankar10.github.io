---
// "Ask my portfolio": real retrieval over this site, in the browser.
// Nothing heavy loads until the visitor focuses the box or picks a question.
const suggestions = [
  'Tell me about yourself',
  'What is your notice period?',
  'What was the hardest problem you solved?',
  'What were the eval results?',
  'How does he evaluate retrieval?',
  'What happens when the manuals don’t have the answer?',
];
---

<section id="ask" data-ask aria-labelledby="ask-title" class="rounded-xl border border-line bg-surface">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 border-b border-line px-4 py-2.5 font-mono text-xs sm:px-5">
    <h2 id="ask-title" class="text-mint">&gt; ask my portfolio</h2>
    <span class="text-fg-subtle">semantic search · runs in your browser · no server</span>
  </div>

  <div class="p-4 sm:p-5">
    <form data-ask-form class="flex gap-2" role="search">
      <label for="ask-input" class="sr-only">Ask a question about Roop's work</label>
      <input
        id="ask-input"
        data-ask-input
        type="search"
        autocomplete="off"
        maxlength="200"
        placeholder="Ask anything, e.g. Are you open to relocation?"
        class="h-10 min-w-0 flex-1 rounded-md border border-line-strong bg-bg px-3 font-mono text-sm text-fg placeholder:text-fg-subtle focus:border-mint focus:outline-none"
      />
      <button type="submit" class="h-10 rounded-md bg-mint px-4 text-sm font-medium text-mint-ink hover:opacity-90">Ask</button>
    </form>
    <p data-ask-error class="mt-2 hidden text-xs text-amber" role="alert">Type a question first.</p>

    <ul class="mt-3 flex flex-wrap gap-2" aria-label="Suggested questions">
      {
        suggestions.map((q) => (
          <li>
            <button type="button" data-ask-chip class="rounded-full border border-line px-3 py-1 text-xs text-fg-muted hover:border-mint hover:text-fg">
              {q}
            </button>
          </li>
        ))
      }
    </ul>

    <div class="mt-4 font-mono text-xs text-fg-subtle">
      <p data-ask-model>model: bge-small-en-v1.5 · loads when you ask (keyword search answers meanwhile)</p>
      <div data-ask-progress class="mt-1.5 hidden h-1 overflow-hidden rounded-full bg-surface-2" aria-hidden="true">
        <div data-ask-progress-bar class="h-full w-0 bg-mint transition-[width]"></div>
      </div>
    </div>

    <div data-ask-results aria-live="polite" class="mt-4 empty:hidden"></div>

    <p class="mt-4 text-xs text-fg-subtle">
      Answers are passages quoted from this page, not generated text. If nothing matches, it says so.{' '}
      <a href="/how-this-site-works" class="text-mint underline underline-offset-2">How this works</a>
    </p>
  </div>
</section>

<script>
  import '../scripts/ask';
</script>

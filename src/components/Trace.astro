---
// Experience rendered as an observability trace: one span per role, a duration bar on a
// timeline that starts at the first role, and 2–3 impact bullets that link to project cards.
import { trace, allProjects, type Span } from '../data/content';

const NOW = Date.now();
const toMs = (d: string) => (d === 'present' ? NOW : new Date(`${d}-01`).getTime());
const firstStart = Math.min(...trace.filter((s) => s.start).map((s) => toMs(s.start!)));
const AXIS_START = new Date(new Date(firstStart).getFullYear(), new Date(firstStart).getMonth() - 1, 1).getTime();
const pct = (ms: number) => ((ms - AXIS_START) / (NOW - AXIS_START)) * 100;
const projectName = Object.fromEntries(allProjects.map((p) => [p.id, p.name]));

function duration(s: Span) {
  if (!s.start || !s.end) return '';
  const months = Math.floor((toMs(s.end) - toMs(s.start)) / (1000 * 60 * 60 * 24 * 30.44));
  const y = Math.floor(months / 12);
  const m = months % 12;
  return [y ? `${y}y` : '', m ? `${m}m` : ''].filter(Boolean).join(' ');
}

// Axis ticks: January of each year in range, plus the first role's start month.
const ticks: { label: string; at: number }[] = [];
for (let y = new Date(AXIS_START).getFullYear() + 1; y <= new Date(NOW).getFullYear(); y++)
  ticks.push({ label: String(y), at: pct(new Date(`${y}-01-01`).getTime()) });
---

<div data-reveal class="overflow-hidden rounded-xl border border-line bg-surface">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 border-b border-line px-4 py-2.5 font-mono text-xs text-fg-subtle sm:px-5">
    <span class="text-mint">trace</span><span>career</span><span aria-hidden="true">·</span>
    <span>{trace.length} {trace.length === 1 ? 'span' : 'spans'}</span><span aria-hidden="true">·</span><span>status: running</span>
  </div>

  <ol class="divide-y divide-line">
    {
      trace.map((s, i) => {
        const left = pct(toMs(s.start!));
        const width = pct(toMs(s.end!)) - left;
        return (
          <li class="px-4 py-5 sm:px-5">
            <div class="grid gap-3 md:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] md:items-center md:gap-4">
              <div class="min-w-0">
                <p class="font-semibold text-fg">{s.name}</p>
                <p class="mt-0.5 text-sm text-fg-muted">{s.meta}</p>
                <p class="mt-0.5 font-mono text-xs text-fg-subtle">{s.when} · {duration(s)}</p>
              </div>
              <div class="relative h-9" aria-hidden="true">
                {ticks.map((t) => (
                  <span class="absolute top-0 -translate-x-1/2 font-mono text-[11px] text-fg-subtle" style={`left:${t.at}%`}>
                    {t.label}
                  </span>
                ))}
                <div class="span-bar absolute bottom-1 h-2 rounded-sm bg-mint" style={`left:${left}%;width:${Math.max(width, 1)}%;--i:${i}`} />
              </div>
            </div>
            {s.impact && (
              <ul class="mt-4 space-y-2.5">
                {s.impact.map((b) => (
                  <li class="flex gap-3 text-[15px] leading-relaxed text-fg-muted">
                    <span class="mt-[0.55em] size-1.5 shrink-0 rounded-full bg-mint" aria-hidden="true" />
                    <span>
                      {b.text}
                      {b.projectId && (
                        <>
                          {' '}
                          <a href={`#project-${b.projectId}`} class="whitespace-nowrap font-mono text-xs text-mint underline underline-offset-2">
                            view project<span class="sr-only">: {projectName[b.projectId]}</span>
                          </a>
                        </>
                      )}
                    </span>
                  </li>
                ))}
              </ul>
            )}
          </li>
        );
      })
    }
  </ol>
</div>

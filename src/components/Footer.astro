---
import { profile } from '../data/site';
// Build time = deploy time on GitHub Pages, so this is the real "last deployed" date.
const deployed = new Date().toISOString().slice(0, 10);
---

<footer class="mt-16 border-t border-line">
  <div class="mx-auto flex max-w-5xl flex-col gap-2 px-5 py-8 font-mono text-xs text-fg-subtle sm:px-8">
    <p class="flex flex-wrap items-center gap-x-2 gap-y-1">
      <span class="inline-block size-2 rounded-full bg-mint" aria-hidden="true"></span>
      <span class="whitespace-nowrap">all systems operational</span>
      <span aria-hidden="true">·</span>
      <span class="whitespace-nowrap">last deployed <time datetime={deployed}>{deployed}</time></span>
      <span aria-hidden="true">·</span>
      <span class="whitespace-nowrap">built with Astro + transformers.js</span>
    </p>
    <p class="flex flex-wrap items-center gap-x-2 gap-y-1">
      <a href="/how-this-site-works" class="whitespace-nowrap hover:text-mint">how this site works</a>
      <span aria-hidden="true" class="desktop-hint hidden sm:inline">·</span>
      <span class="desktop-hint hidden whitespace-nowrap sm:inline">press <kbd class="kbd">`</kbd> for a terminal · <kbd class="kbd" data-cmdk-key>ctrl k</kbd> to jump</span>
      <span aria-hidden="true">·</span>
      <span class="whitespace-nowrap">© {new Date().getFullYear()} {profile.name}</span>
    </p>
  </div>
</footer>

---
import type { Project } from '../data/content';
import Arrow from './Arrow.astro';
interface Props {
  project: Project;
}
const { project: p } = Astro.props;
const soon = p.status === 'coming-soon';
const steps = p.pipeline.filter((s) => s.detail);
const fmtDate = (d: string) => new Date(`${d}T00:00:00`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const doneCount = p.milestones?.filter((m) => m.done).length ?? 0;
// Only rows with real numbers are shown; the table appears once there's something to compare.
const baselineRows = (p.baselines ?? []).filter((b) => b.hit5 && b.meanRank);
---

<article
  data-reveal
  data-pipeline={soon ? undefined : 'live'}
  id={`project-${p.id}`}
  aria-labelledby={`project-${p.id}-title`}
  class:list={[
    'rounded-xl border bg-surface p-5 sm:p-7',
    soon ? 'border-dashed border-line-strong' : 'border-line',
  ]}
>
  <header class="flex flex-col items-start gap-x-4 gap-y-2 sm:flex-row">
    <div class="min-w-0 flex-1">
      <p class="font-mono text-xs text-fg-subtle">model_card · {p.id}</p>
      <h3 id={`project-${p.id}-title`} class="mt-1 text-xl font-semibold tracking-tight text-fg sm:text-2xl">
        {p.name}
      </h3>
      <p class="mt-1 text-sm text-fg-muted">{p.context}</p>
    </div>
    {
      soon ? (
        <span class="rounded border border-amber/40 bg-amber-wash px-2 py-0.5 font-mono text-xs text-amber">
          in progress{p.updated && <> · updated <time datetime={p.updated}>{fmtDate(p.updated)}</time></>}
        </span>
      ) : null
    }
  </header>

  <div class="mt-6 grid gap-8 lg:grid-cols-2">
    <div class="space-y-6">
      <div>
        <h4 class="font-mono text-xs uppercase tracking-wider text-fg-subtle">Problem</h4>
        <p class="mt-2 text-[15px] leading-relaxed text-fg">{p.problem}</p>
      </div>

      {
        p.milestones ? (
          <div>
            <h4 class="font-mono text-xs uppercase tracking-wider text-fg-subtle">
              Progress · {doneCount}/{p.milestones.length}
            </h4>
            <ul class="mt-2 space-y-1.5 text-[15px]">
              {p.milestones.map((m) => (
                <li class="flex items-center gap-2.5">
                  <span
                    class:list={['grid size-4 shrink-0 place-items-center rounded border text-[10px]', m.done ? 'border-mint bg-mint text-mint-ink' : 'border-line-strong']}
                    aria-hidden="true"
                  >
                    {m.done ? '✓' : ''}
                  </span>
                  <span class={m.done ? 'text-fg' : 'text-fg-muted'}>{m.label}</span>
                  <span class="sr-only">{m.done ? '(done)' : '(planned)'}</span>
                  {!m.done && <span class="font-mono text-xs text-fg-subtle" aria-hidden="true">planned</span>}
                </li>
              ))}
            </ul>
          </div>
        ) : (
      <div>
        <h4 class="font-mono text-xs uppercase tracking-wider text-fg-subtle">
          Key decisions
        </h4>
        <ul class="mt-2 space-y-1.5 text-[15px] text-fg-muted">
          {
            p.decisions.map((d) => (
              <li class="flex gap-2">
                <span class="mt-[0.6em] size-1.5 shrink-0 rounded-full bg-mint" aria-hidden="true" />
                <span>{d}</span>
              </li>
            ))
          }
        </ul>
      </div>
        )
      }
    </div>

    <div class="space-y-6">
      <div>
        <h4 class="font-mono text-xs uppercase tracking-wider text-fg-subtle">Architecture</h4>
        <ol class="mt-3 flex flex-wrap items-center gap-y-2 font-mono text-xs" aria-label="Pipeline stages">
          {
            p.pipeline.map((s, i) => (
              <li class="flex items-center" style={`--i:${i}`}>
                <span
                  class:list={[
                    'pipe-stage rounded border px-2 py-1 transition-colors duration-200',
                    soon ? 'border-dashed border-line-strong text-fg-subtle' : 'border-mint/40 bg-mint-wash text-mint',
                  ]}
                >
                  {s.stage}
                </span>
                {i < p.pipeline.length - 1 && (
                  <span class="pipe-arrow inline-flex" aria-hidden="true">
                    <Arrow />
                  </span>
                )}
              </li>
            ))
          }
        </ol>
        {
          steps.length > 0 && (
            <dl class="mt-3 space-y-1 text-sm">
              {steps.map((s) => (
                <div class="grid grid-cols-[5.5rem_1fr] gap-2">
                  <dt class="font-mono text-xs leading-5 text-fg-subtle">{s.stage}</dt>
                  <dd class="text-fg-muted">{s.detail}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>

      <div>
        <h4 class="font-mono text-xs uppercase tracking-wider text-fg-subtle">Eval results</h4>
        {
          p.metrics.length > 0 ? (
            <ul class="mt-3 space-y-3">
              {p.metrics.map((m, i) => (
                <li style={`--i:${i}`}>
                  <div class="flex items-baseline justify-between gap-3 text-sm">
                    <span class="text-fg-muted">
                      {m.label}
                      {m.note && <span class="text-fg-subtle"> · {m.note}</span>}
                    </span>
                    <span class="sr-only">: </span>
                    <span class="font-mono font-semibold text-amber">{m.value}</span>
                  </div>
                  {m.ratio !== undefined && (
                    <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-surface-2" aria-hidden="true">
                      <div class="metric-bar h-full rounded-full bg-amber" style={`width:${(m.ratio * 100).toFixed(1)}%`} />
                    </div>
                  )}
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-2 font-mono text-xs text-fg-subtle">{p.metricsNote}</p>
          )
        }
        {
          baselineRows.length > 1 && (
            <div class="mt-5 overflow-x-auto">
              <table class="w-full text-left text-sm">
                <caption class="sr-only">Retriever comparison on the same eval set</caption>
                <thead>
                  <tr class="border-b border-line font-mono text-[11px] uppercase tracking-wider text-fg-subtle">
                    <th scope="col" class="py-1.5 pr-3 font-normal">Retriever</th>
                    <th scope="col" class="py-1.5 pr-3 font-normal">hit@5</th>
                    <th scope="col" class="py-1.5 font-normal">Mean hit rank</th>
                  </tr>
                </thead>
                <tbody>
                  {baselineRows.map((b, i) => (
                    <tr class="border-b border-line last:border-0">
                      <th scope="row" class:list={['py-1.5 pr-3 font-normal', i === 0 ? 'text-fg' : 'text-fg-muted']}>{b.name}</th>
                      <td class:list={['py-1.5 pr-3 font-mono', i === 0 ? 'font-semibold text-amber' : 'text-fg-muted']}>{b.hit5}</td>
                      <td class:list={['py-1.5 font-mono', i === 0 ? 'font-semibold text-amber' : 'text-fg-muted']}>{b.meanRank}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }
        {p.evalNote && <p class="mt-3 text-xs leading-relaxed text-fg-subtle">{p.evalNote}</p>}
        {
          p.id === 'sia' && (
            <p class="mt-2 text-xs leading-relaxed text-fg-subtle">
              Guardrails: citations validated in code, explicit NOT_FOUND.{' '}
              <a href="#principles" class="text-mint underline underline-offset-2">How I build</a>
            </p>
          )
        }
      </div>
    </div>
  </div>

  <footer class="mt-7 flex flex-col gap-4 border-t border-line pt-5 sm:flex-row sm:items-center">
    <ul class="flex flex-wrap gap-1.5" aria-label="Stack">
      {
        p.stack.map((s) => (
          <li class="rounded border border-line px-2 py-0.5 font-mono text-xs text-fg-muted">{s}</li>
        ))
      }
    </ul>
    <div class="flex flex-wrap gap-2 sm:ml-auto">
      {
        p.links
          .filter((l) => l.href)
          .map((l) => (
            <a href={l.href!} target="_blank" rel="noopener" class="rounded-md border border-line-strong px-3 py-1 text-sm text-fg hover:border-mint">
              {l.label} ↗
            </a>
          ))
      }
    </div>
  </footer>
  {p.linksNote && <p class="mt-3 font-mono text-xs text-fg-subtle">{p.linksNote}</p>}
</article>

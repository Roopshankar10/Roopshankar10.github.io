---
// Every Q&A answer is plain HTML on the page (recruiter-first: nothing hidden behind the search box).
import { faq, faqGroups } from '../data/faq';
---

<div class="grid gap-x-10 gap-y-10 lg:grid-cols-2">
  {
    faqGroups.map((g) => (
      <div>
        <h3 class="font-mono text-xs uppercase tracking-wider text-mint">{g}</h3>
        <dl class="mt-4 space-y-5">
          {faq
            .filter((f) => f.group === g)
            .map((f) => (
              <div id={`faq-${f.id}`} class="scroll-mt-20 rounded-md">
                <dt class="font-medium text-fg">{f.q}</dt>
                <dd class="mt-1 text-[15px] leading-relaxed text-fg-muted">{f.a}</dd>
              </div>
            ))}
        </dl>
      </div>
    ))
  }
</div>

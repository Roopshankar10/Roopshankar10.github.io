---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

// Drafts are built in `npm run dev` only, so they never go live by accident.
export async function getStaticPaths() {
  const notes = await getCollection('notes', (n) => import.meta.env.DEV || !n.data.draft);
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}
const { note } = Astro.props;
const { Content } = await render(note);
---

<Base title={`${note.data.title} · Notes`} description={note.data.summary}>
  <article class="py-16 sm:py-20">
    <p class="font-mono text-xs text-fg-subtle">
      <a href="/#notes" class="text-mint underline underline-offset-2">~/notes</a> / {note.id}
      {note.data.draft && <span class="ml-2 text-amber">draft · only visible in dev</span>}
    </p>
    <h1 class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight sm:text-4xl">{note.data.title}</h1>
    <p class="mt-3 max-w-3xl text-lg text-fg-muted">{note.data.summary}</p>
    {note.data.date && <p class="mt-2 font-mono text-xs text-fg-subtle">{note.data.date.toISOString().slice(0, 10)}</p>}
    <div class="prose-note mt-10 max-w-3xl">
      <Content />
    </div>
  </article>
</Base>

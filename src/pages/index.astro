---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionShell from '../components/SectionShell.astro';
import ModelCard from '../components/ModelCard.astro';
import Trace from '../components/Trace.astro';
import Skills from '../components/Skills.astro';
import AskPanel from '../components/AskPanel.astro';
import SkillSpace from '../components/SkillSpace.astro';
import { profile } from '../data/site';
import { getCollection } from 'astro:content';
import { projects, academicProjects, principles, education, certifications } from '../data/content';
import AcademicCard from '../components/AcademicCard.astro';
const notes = (await getCollection('notes')).sort((a, b) => Number(a.data.draft) - Number(b.data.draft));
---

<Base>
  <Hero />

  <AskPanel />

  <SectionShell id="projects" index={1} label="projects" title="Projects, as model cards">
    <div class="space-y-6">
      {projects.map((p) => <ModelCard project={p} />)}
    </div>
    <h3 class="mt-14 font-mono text-xs uppercase tracking-wider text-fg-subtle">
      Earlier work · B.Tech projects
    </h3>
    <div class="mt-4 grid gap-4 md:grid-cols-3">
      {academicProjects.map((p) => <AcademicCard project={p} />)}
    </div>
  </SectionShell>

  <SectionShell id="experience" index={2} label="experience" title="Experience, as a trace">
    <p class="mb-6 max-w-3xl text-[15px] leading-relaxed text-fg-muted">{profile.summary}</p>
    <Trace />
  </SectionShell>

  <SectionShell id="skills" index={3} label="skills" title="Skills">
    <SkillSpace />
    <div class="mt-6"><Skills /></div>
  </SectionShell>

  <SectionShell id="principles" index={4} label="how I build" title="How I build">
    <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        principles.map((p, i) => (
          <li class="rounded-xl border border-line bg-surface p-5">
            <p class="font-mono text-xs text-mint">0{i + 1}</p>
            <h3 class="mt-2 font-semibold text-fg">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-fg-muted">{p.body}</p>
          </li>
        ))
      }
    </ol>
  </SectionShell>

  <SectionShell id="education" index={5} label="education" title="Education and certifications">
    <div class="grid gap-4 md:grid-cols-2">
      {
        education.map((e) => (
          <div class="rounded-xl border border-line bg-surface p-5">
            <p class="font-mono text-xs text-fg-subtle">education · {e.years}</p>
            <h3 class="mt-2 font-semibold text-fg">{e.degree}</h3>
            <p class="mt-1 text-sm text-fg-muted">{e.school}</p>
          </div>
        ))
      }
      <div class="rounded-xl border border-line bg-surface p-5">
        <p class="font-mono text-xs text-fg-subtle">certifications</p>
        <ul class="mt-2 space-y-3">
          {
            certifications.map((c) => (
              <li>
                <h3 class="font-semibold text-fg">{c.name}</h3>
                <p class="text-sm text-fg-muted">{c.issuer}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </SectionShell>

  <SectionShell id="notes" index={6} label="notes" title="Notes">
    <ul class="space-y-3">
      {
        notes.map((n) => {
          const live = !n.data.draft || import.meta.env.DEV;
          return (
            <li class:list={['rounded-xl border bg-surface p-5', n.data.draft ? 'border-dashed border-line-strong' : 'border-line']}>
              <p class="font-mono text-xs">
                {n.data.draft ? <span class="text-amber">draft · coming soon</span> : <span class="text-fg-subtle">{n.data.tags.join(' · ')}</span>}
              </p>
              <h3 class="mt-2 font-semibold text-fg">
                {live ? <a href={`/notes/${n.id}`} class="hover:text-mint">{n.data.title}</a> : n.data.title}
              </h3>
              <p class="mt-1 text-sm text-fg-muted">{n.data.summary}</p>
            </li>
          );
        })
      }
    </ul>
  </SectionShell>

  <SectionShell id="contact" index={7} label="contact" title="Get in touch">
    <ul class="grid gap-3 font-mono text-sm sm:grid-cols-3">
      <li>
        <a class="block rounded-md border border-line p-4 hover:border-mint" href={`mailto:${profile.email}`}>
          <span class="block text-xs text-fg-subtle">email</span>
          <span class="mt-1 block break-all text-fg">{profile.email}</span>
        </a>
      </li>
      <li>
        <a class="block rounded-md border border-line p-4 hover:border-mint" href={profile.links.linkedin} rel="me noopener" target="_blank">
          <span class="block text-xs text-fg-subtle">linkedin</span>
          <span class="mt-1 block text-fg">/in/roopshankarvoruganti</span>
        </a>
      </li>
      <li>
        <a class="block rounded-md border border-line p-4 hover:border-mint" href={profile.links.github} rel="me noopener" target="_blank">
          <span class="block text-xs text-fg-subtle">github</span>
          <span class="mt-1 block text-fg">@Roopshankar10</span>
        </a>
      </li>
    </ul>
  </SectionShell>
</Base>
